<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 keeps the package usable from .NET Framework 4.7.2+; net8.0 is the modern LTS target. -->
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>true</IsPackable>

    <PackageId>SheetStream.NET</PackageId>
    <Version>0.4.0</Version>
    <Authors>P4 Software</Authors>
    <Company>P4 Software</Company>
    <Description>Lightweight, dependency-free, MIT-licensed .xlsx library for .NET: streaming writer with tables, charts, pictures, conditional formatting, validation, protection and AutoFit, plus a streaming reader. A free alternative to EPPlus.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/P4Software/SheetStream.NET</PackageProjectUrl>
    <RepositoryUrl>https://github.com/P4Software/SheetStream.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>excel;xlsx;openxml;spreadsheet;streaming;epplus;export</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Official P4 Software logo, padded (not stretched) to the square canvas NuGet displays. -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>See https://github.com/P4Software/SheetStream.NET/releases</PackageReleaseNotes>

    <!-- Symbols and Source Link so consumers can step into the library from the published package. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!--
    Trimming and Native AOT. IsAotCompatible turns on the trim, AOT and single-file analyzers, so every
    reflection path in the library is either annotated or routed through a compile-time mapper. The
    properties only exist on net8.0+; netstandard2.0 consumers are never trimmed.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SheetStream.Tests" />
  </ItemGroup>

  <!--
    The source generator ships inside this package. The ProjectReference only orders the build (nothing is
    referenced at runtime); the None item drops the built generator into analyzers/dotnet/cs, where the
    consuming compiler picks it up. It is deliberately not under lib/, so it never becomes a runtime dependency.
  -->
  <ItemGroup>
    <ProjectReference Include="../SheetStream.Generators/SheetStream.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <None Include="../SheetStream.Generators/bin/$(Configuration)/netstandard2.0/SheetStream.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <!-- Design-time analyzer (SS0001-SS0003) shipped inside this package. ReferenceOutputAssembly=false only orders
         the build; PrivateAssets=all keeps it out of the package's dependency list. -->
    <ProjectReference Include="../SheetStream.Analyzers/SheetStream.Analyzers.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="../SheetStream.Analyzers/bin/$(Configuration)/netstandard2.0/SheetStream.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
