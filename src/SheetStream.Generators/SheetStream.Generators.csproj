<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Analyzers must target netstandard2.0 so the same DLL loads in Visual Studio (net48) and in the dotnet CLI. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>SheetStream.Generators</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Source generator plumbing: debuggable as a Roslyn component, held to the analyzer API rules, and never
         shipped as a runtime assembly. The SheetStream package picks the DLL up into analyzers/dotnet/cs. -->
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IsPackable>false</IsPackable>
    <!-- The generator is loaded by the compiler, not referenced at runtime, so a fixed output name keeps the pack path stable. -->
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <!-- 4.8.0 is the compiler shipped with .NET 8 / VS 17.8: the oldest host the generator supports.
         Newer SDKs (including .NET 10) load it unchanged. PrivateAssets keeps it out of any consumer's graph. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.CodeAnalysis.Analyzers adds AnalyzerReleases.Shipped.md and .Unshipped.md as AdditionalFiles by
         itself (its .props does it); listing them again here made docfx report duplicate source files. -->
  </ItemGroup>

</Project>
