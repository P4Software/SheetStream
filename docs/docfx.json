{
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [ "SheetStream/SheetStream.csproj", "SheetStream.AspNetCore/SheetStream.AspNetCore.csproj" ]
        }
      ],
      "dest": "api",
      "properties": { "TargetFramework": "net8.0" }
    }
  ],
  "build": {
    "content": [
      { "files": [ "api/**.yml", "api/index.md" ] },
      { "files": [ "*.md", "toc.yml" ], "exclude": [ "_site/**" ] }
    ],
    "resource": [ { "files": [ "images/**" ] } ],
    "dest": "_site",
    "template": [ "default", "modern" ],
    "globalMetadata": {
      "_appTitle": "SheetStream",
      "_appName": "SheetStream",
      "_appLogoPath": "images/logo.png",
      "_appFaviconPath": "images/logo.png",
      "_appFooter": "SheetStream is MIT licensed and published by P4 Software.",
      "_enableSearch": true,
      "_gitContribute": { "repo": "https://github.com/P4Software/SheetStream", "branch": "main" }
    }
  }
}
